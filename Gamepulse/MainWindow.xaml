<Window x:Class="Gamepulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GamePulse AI"
        Height="1000"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="GamePulse AI"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Low-overhead gaming performance diagnostics"
                       FontSize="16"
                       Foreground="#9CA3AF"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="StartButton"
                        Content="Start Session"
                        Width="150"
                        Height="44"
                        Margin="0,0,12,0"
                        Click="StartButton_Click"/>

                <Button x:Name="StopButton"
                        Content="Stop Session"
                        Width="150"
                        Height="44"
                        Click="StopButton_Click"/>

                <TextBlock x:Name="StatusText"
                           Text="Status: Idle"
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="DurationText"
                           Text="Session Duration: 00:00:00"
                           Foreground="#9CA3AF"
                           FontSize="15"
                           Margin="0,0,32,0"/>

                <TextBlock x:Name="SamplesText"
                           Text="Samples Recorded: 0"
                           Foreground="#9CA3AF"
                           FontSize="15"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,12,0">

                <StackPanel>
                    <TextBlock Text="CPU Usage"
                               Foreground="#9CA3AF"
                               FontSize="16"/>

                    <TextBlock x:Name="CpuText"
                               Text="0%"
                               Foreground="White"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="Total processor usage"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="24"
                    Margin="12,0,12,0">

                <StackPanel>
                    <TextBlock Text="RAM Usage"
                               Foreground="#9CA3AF"
                               FontSize="16"/>

                    <TextBlock x:Name="RamText"
                               Text="0%"
                               Foreground="White"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>

                    <TextBlock x:Name="RamDetailsText"
                               Text="0.0 GB / 0.0 GB"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="24"
                    Margin="12,0,0,0">

                <StackPanel>
                    <TextBlock Text="Disk Usage"
                               Foreground="#9CA3AF"
                               FontSize="16"/>

                    <TextBlock x:Name="DiskText"
                               Text="0%"
                               Foreground="White"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>

                    <TextBlock x:Name="DiskDetailsText"
                               Text="Read 0.0 MB/s | Write 0.0 MB/s"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,12,0">

                <StackPanel>
                    <TextBlock Text="GPU 0"
                               Foreground="#9CA3AF"
                               FontSize="16"/>

                    <TextBlock x:Name="Gpu0Text"
                               Text="0%"
                               Foreground="White"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>

                    <TextBlock x:Name="Gpu0DetailsText"
                               Text="Not detected"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="24"
                    Margin="12,0,0,0">

                <StackPanel>
                    <TextBlock Text="GPU 1"
                               Foreground="#9CA3AF"
                               FontSize="16"/>

                    <TextBlock x:Name="Gpu1Text"
                               Text="0%"
                               Foreground="White"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>

                    <TextBlock x:Name="Gpu1DetailsText"
                               Text="Not detected"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="#1F2937"
                CornerRadius="12"
                Padding="24"
                Margin="0,0,0,24">

            <StackPanel>
                <TextBlock Text="Active Process"
                           Foreground="#9CA3AF"
                           FontSize="16"/>

                <TextBlock x:Name="ActiveProcessText"
                           Text="None"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,12,0,0"/>

                <TextBlock x:Name="ActiveProcessDetailsText"
                           Text="RAM 0 MB"
                           Foreground="#9CA3AF"
                           FontSize="14"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,12,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Session Summary"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <TextBlock x:Name="SummaryText"
                                   Text="No session summary yet. Start and stop a session to generate one."
                                   Foreground="#D1D5DB"
                                   FontSize="15"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="24"
                    Margin="12,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Frame Summary"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <TextBlock x:Name="FrameSummaryText"
                                   Text="No frame summary yet. PresentMon FPS data will appear here after a session."
                                   Foreground="#D1D5DB"
                                   FontSize="15"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>