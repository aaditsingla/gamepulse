<Window x:Class="Gamepulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GamePulse AI"
        Height="760"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="GamePulse AI"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Low-overhead gaming performance diagnostics"
                       FontSize="16"
                       Foreground="#9CA3AF"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="StartButton"
                        Content="Start Session"
                        Width="150"
                        Height="44"
                        Margin="0,0,12,0"
                        Click="StartButton_Click"/>

                <Button x:Name="StopButton"
                        Content="Stop Session"
                        Width="150"
                        Height="44"
                        Click="StopButton_Click"/>

                <TextBlock x:Name="StatusText"
                           Text="Status: Idle"
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="DurationText"
                           Text="Session Duration: 00:00:00"
                           Foreground="#9CA3AF"
                           FontSize="15"
                           Margin="0,0,32,0"/>

                <TextBlock x:Name="SamplesText"
                           Text="Samples Recorded: 0"
                           Foreground="#9CA3AF"
                           FontSize="15"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,12,0">

                <StackPanel>
                    <TextBlock Text="CPU Usage"
                               Foreground="#9CA3AF"
                               FontSize="16"/>

                    <TextBlock x:Name="CpuText"
                               Text="0%"
                               Foreground="White"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="Total processor usage"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="24"
                    Margin="12,0,0,0">

                <StackPanel>
                    <TextBlock Text="RAM Usage"
                               Foreground="#9CA3AF"
                               FontSize="16"/>

                    <TextBlock x:Name="RamText"
                               Text="0%"
                               Foreground="White"
                               FontSize="42"
                               FontWeight="Bold"
                               Margin="0,12,0,0"/>

                    <TextBlock x:Name="RamDetailsText"
                               Text="0.0 GB / 0.0 GB"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="#1F2937"
                CornerRadius="12"
                Padding="24">

            <StackPanel>
                <TextBlock Text="Session Summary"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="SummaryText"
                           Text="No session summary yet. Start and stop a session to generate one."
                           Foreground="#D1D5DB"
                           FontSize="15"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>