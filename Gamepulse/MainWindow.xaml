<Window x:Class="Gamepulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GamePulse AI"
        Height="1050"
        Width="1250"
        Background="#0F1724"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="GamePulse AI"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Low-overhead gaming performance diagnostics"
                           FontSize="16"
                           Foreground="#B8C7DC"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,14">
                <Button x:Name="StartButton"
                        Content="Start Session"
                        Width="150"
                        Height="44"
                        Margin="0,0,12,0"
                        Click="StartButton_Click"/>

                <Button x:Name="StopButton"
                        Content="Stop Session"
                        Width="150"
                        Height="44"
                        Margin="0,0,24,0"
                        Click="StopButton_Click"/>

                <TextBlock x:Name="StatusText"
                           Text="Status: Ready"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,0,0,24">
                <TextBlock x:Name="DurationText"
                           Text="Session Duration: 00:00:00"
                           FontSize="15"
                           Foreground="#B8C7DC"
                           Margin="0,0,36,0"/>

                <TextBlock x:Name="SamplesText"
                           Text="Samples Recorded: 0"
                           FontSize="15"
                           Foreground="#B8C7DC"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#1E2938"
                        CornerRadius="12"
                        Padding="24"
                        MinHeight="168">
                    <StackPanel>
                        <TextBlock Text="CPU Usage"
                                   FontSize="16"
                                   Foreground="#B8C7DC"/>
                        <TextBlock x:Name="CpuText"
                                   Text="0%"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,20,0,14"/>
                        <TextBlock Text="Total processor usage"
                                   FontSize="14"
                                   Foreground="#B8C7DC"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="#1E2938"
                        CornerRadius="12"
                        Padding="24"
                        MinHeight="168">
                    <StackPanel>
                        <TextBlock Text="RAM Usage"
                                   FontSize="16"
                                   Foreground="#B8C7DC"/>
                        <TextBlock x:Name="RamText"
                                   Text="0%"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,20,0,14"/>
                        <TextBlock x:Name="RamDetailsText"
                                   Text="0.0 GB / 0.0 GB"
                                   FontSize="14"
                                   Foreground="#B8C7DC"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Background="#1E2938"
                        CornerRadius="12"
                        Padding="24"
                        MinHeight="168">
                    <StackPanel>
                        <TextBlock Text="Disk Usage"
                                   FontSize="16"
                                   Foreground="#B8C7DC"/>
                        <TextBlock x:Name="DiskText"
                                   Text="0%"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,20,0,14"/>
                        <TextBlock x:Name="DiskDetailsText"
                                   Text="Read 0.0 MB/s | Write 0.0 MB/s"
                                   FontSize="14"
                                   Foreground="#B8C7DC"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#1E2938"
                        CornerRadius="12"
                        Padding="24"
                        MinHeight="168">
                    <StackPanel>
                        <TextBlock Text="GPU 0"
                                   FontSize="16"
                                   Foreground="#B8C7DC"/>
                        <TextBlock x:Name="Gpu0Text"
                                   Text="0%"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,20,0,14"/>
                        <TextBlock x:Name="Gpu0DetailsText"
                                   Text="Not detected"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="#B8C7DC"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="#1E2938"
                        CornerRadius="12"
                        Padding="24"
                        MinHeight="168">
                    <StackPanel>
                        <TextBlock Text="GPU 1"
                                   FontSize="16"
                                   Foreground="#B8C7DC"/>
                        <TextBlock x:Name="Gpu1Text"
                                   Text="0%"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,20,0,14"/>
                        <TextBlock x:Name="Gpu1DetailsText"
                                   Text="Not detected"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="#B8C7DC"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="5"
                    Background="#1E2938"
                    CornerRadius="12"
                    Padding="24"
                    MinHeight="145"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Active Process"
                               FontSize="16"
                               Foreground="#B8C7DC"/>
                    <TextBlock x:Name="ActiveProcessText"
                               Text="None"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,18,0,14"/>
                    <TextBlock x:Name="ActiveProcessDetailsText"
                               Text="CPU N/A | RAM 0 MB"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="#B8C7DC"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#1E2938"
                            CornerRadius="12"
                            Padding="24"
                            MinHeight="210">
                        <StackPanel>
                            <TextBlock Text="Session Summary"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,16"/>

                            <ScrollViewer Height="130"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="SummaryText"
                                           Text="No session summary yet."
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Foreground="White"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#1E2938"
                            CornerRadius="12"
                            Padding="24"
                            MinHeight="210">
                        <StackPanel>
                            <TextBlock Text="Frame Summary"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,16"/>

                            <ScrollViewer Height="130"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="FrameSummaryText"
                                           Text="No frame summary yet."
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Foreground="White"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Background="#1E2938"
                        CornerRadius="12"
                        Padding="24"
                        MinHeight="360"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Performance Analysis"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,16"/>

                        <ScrollViewer Height="270"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PerformanceAnalysisText"
                                       Text="No performance analysis yet."
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       LineHeight="21"
                                       Foreground="White"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>